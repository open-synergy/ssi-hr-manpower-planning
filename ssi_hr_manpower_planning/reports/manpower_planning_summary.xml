<odoo>
    <!-- Paper format: portrait A4 -->
    <record id="manpower_planning_summary_paperformat" model="report.paperformat">
        <field name="name">Manpower Planning Summary - Portrait</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_manpower_planning_summary_html" model="ir.actions.report">
        <field name="name">Manpower Planning Summary</field>
        <field name="model">manpower_planning</field>
        <field name="report_type">qweb-html</field>
        <field
            name="report_name"
        >ssi_hr_manpower_planning.manpower_planning_summary</field>
        <field
            name="report_file"
        >ssi_hr_manpower_planning.manpower_planning_summary</field>
        <field name="binding_model_id" ref="model_manpower_planning" />
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('manpower_planning_viewer_group'))]" />
    </record>

    <record id="action_report_manpower_planning_summary_pdf" model="ir.actions.report">
        <field name="name">Manpower Planning Summary PDF</field>
        <field name="model">manpower_planning</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >ssi_hr_manpower_planning.manpower_planning_summary</field>
        <field
            name="report_file"
        >ssi_hr_manpower_planning.manpower_planning_summary</field>
        <field name="paperformat_id" ref="manpower_planning_summary_paperformat" />
        <field name="binding_model_id" ref="model_manpower_planning" />
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('manpower_planning_viewer_group'))]" />
    </record>

    <record id="action_report_manpower_planning_summary_xlsx" model="ir.actions.report">
        <field name="name">Manpower Planning Summary XLSX</field>
        <field name="model">manpower_planning</field>
        <field name="report_type">xlsx</field>
        <field
            name="report_name"
        >ssi_hr_manpower_planning.manpower_planning_summary_xlsx</field>
        <field
            name="report_file"
        >ssi_hr_manpower_planning.manpower_planning_summary_xlsx</field>
        <field name="binding_model_id" ref="model_manpower_planning" />
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('manpower_planning_viewer_group'))]" />
    </record>

</odoo>
