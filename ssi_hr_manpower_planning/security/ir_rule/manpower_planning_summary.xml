<odoo>
<record id="manpower_planning_summary_internal_user_rule" model="ir.rule">
    <field name="name">Manpower Planning Summary - Internal Users</field>
    <field name="model_id" ref="model_manpower_planning_summary" />
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="domain_force">[('user_id','=',user.id)]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>

<record id="manpower_planning_summary_company_rule" model="ir.rule">
    <field name="name">Manpower Planning Summary - Responsible to company data</field>
    <field name="model_id" ref="model_manpower_planning_summary" />
    <field name="groups" eval="[(4, ref('manpower_planning_company_group'))]" />
    <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>

<record id="manpower_planning_summary_companies_rule" model="ir.rule">
    <field
            name="name"
        >Manpower Planning Summary - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_manpower_planning_summary" />
    <field name="groups" eval="[(4, ref('manpower_planning_company_child_group'))]" />
    <field name="domain_force">[('company_id','in',user.company_ids.ids)]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>

<record id="manpower_planning_summary_all_rule" model="ir.rule">
    <field name="name">Manpower Planning Summary - Responsible to all data</field>
    <field name="model_id" ref="model_manpower_planning_summary" />
    <field name="groups" eval="[(4, ref('manpower_planning_all_group'))]" />
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
</record>

</odoo>
