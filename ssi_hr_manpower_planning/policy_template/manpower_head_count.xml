<odoo noupdate="1">
<record id="manpower_head_count_policy_template" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_manpower_head_count" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','manpower_head_count'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<record
        id="manpower_head_count_policy_template_detail_done"
        model="policy.template_detail"
    >
    <field name="template_id" ref="manpower_head_count_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','manpower_head_count'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','manpower_head_count'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('manpower_head_count_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<record
        id="manpower_head_count_policy_template_detail_cancel"
        model="policy.template_detail"
    >
    <field name="template_id" ref="manpower_head_count_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','manpower_head_count'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','manpower_head_count'),('value','in',['draft','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('manpower_head_count_validator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

<record
        id="manpower_head_count_policy_template_detail_restart"
        model="policy.template_detail"
    >
    <field name="template_id" ref="manpower_head_count_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','manpower_head_count'),('name','=','restart_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','manpower_head_count'),('value','=','cancel')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('manpower_head_count_validator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

<record
        id="manpower_head_count_policy_template_detail_manual_number"
        model="policy.template_detail"
    >
    <field name="template_id" ref="manpower_head_count_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','manpower_head_count'),('name','=','manual_number_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','manpower_head_count'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('manpower_head_count_validator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>
</odoo>
