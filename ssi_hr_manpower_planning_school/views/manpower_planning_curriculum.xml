<odoo>
<record id="manpower_planning_curriculum_view_search" model="ir.ui.view">
    <field name="name">manpower_planning_curriculum - search</field>
    <field name="model">manpower_planning_curriculum</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="manpower_planning_curriculum_view_tree" model="ir.ui.view">
    <field name="name">manpower_planning_curriculum - tree</field>
    <field name="model">manpower_planning_curriculum</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="manpower_planning_curriculum_view_form" model="ir.ui.view">
    <field name="name">manpower_planning_curriculum - form</field>
    <field name="model">manpower_planning_curriculum</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="curriculum" string="Curriculum">
                    <group name="curriculum_group_1">
                        <field name="description" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="manpower_planning_curriculum_action" model="ir.actions.act_window">
    <field name="name">Curriculums</field>
    <field name="res_model">manpower_planning_curriculum</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="manpower_planning_curriculum_menu"
        name="Curriculums"
        parent="ssi_hr_manpower_planning.manpower_planning_configuration_menu"
        action="manpower_planning_curriculum_action"
        groups="manpower_planning_curriculum_group"
        sequence="20"
    />
</odoo>
